{
  "name": "control-maquila",
  "version": "2.1.0",
  "private": true,
  "description": "Control de Maquila de Panetones (PWA + Google Sheets)",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "stamp": "node tools/stamp.js",
    "stamp:check": "node tools/stamp.js --check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/run.cjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
